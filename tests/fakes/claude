#!/usr/bin/env python3
"""Fake claude: prints the lines of $FAKE_CLAUDE_STREAM, one every $FAKE_CLAUDE_DELAY s; records argv, cwd and cwd listing to $FAKE_CLAUDE_ARGV."""
import json, os, sys, time
if os.environ.get("FAKE_CLAUDE_ARGV"):
    json.dump({"argv": sys.argv[1:], "cwd": os.getcwd(), "ls": os.listdir(".")}, open(os.environ["FAKE_CLAUDE_ARGV"], "w"))
for line in open(os.environ["FAKE_CLAUDE_STREAM"]).read().splitlines():
    time.sleep(float(os.environ.get("FAKE_CLAUDE_DELAY") or 0))
    print(line, flush=True)
