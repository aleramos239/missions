#!/usr/bin/env python3
"""Fake claude: prints the lines of $FAKE_CLAUDE_STREAM, one every $FAKE_CLAUDE_DELAY s; records argv, cwd, cwd listing and stdin
to $FAKE_CLAUDE_ARGV. With $FAKE_CLAUDE_CHILD it starts a sleeping child and writes its pid there."""
import json, os, subprocess, sys, time
if os.environ.get("FAKE_CLAUDE_CHILD"):
    open(os.environ["FAKE_CLAUDE_CHILD"], "w").write(str(subprocess.Popen(["sleep", "60"]).pid))
if os.environ.get("FAKE_CLAUDE_ARGV"):
    json.dump({"argv": sys.argv[1:], "cwd": os.getcwd(), "ls": os.listdir("."),
               "stdin_isatty": os.isatty(0), "stdin_devnull": os.path.samestat(os.fstat(0), os.stat("/dev/null"))},
              open(os.environ["FAKE_CLAUDE_ARGV"], "w"))
if os.environ.get("FAKE_CLAUDE_STDERR"):
    print(os.environ["FAKE_CLAUDE_STDERR"], file=sys.stderr, flush=True)
for line in open(os.environ["FAKE_CLAUDE_STREAM"]).read().splitlines():
    time.sleep(float(os.environ.get("FAKE_CLAUDE_DELAY") or 0))
    print(line, flush=True)
