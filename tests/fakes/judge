#!/usr/bin/env python3
"""Fake Judge door: $FAKE_JUDGE is a JSON file {"<argv joined by spaces>": answer}. A {"refused": ..} answer exits 1."""
import json, os, sys, time
key = " ".join(sys.argv[1:])
answers = json.load(open(os.environ["FAKE_JUDGE"]))
if key.split(" ")[0] == "read" and os.environ.get("FAKE_JUDGE_SLEEP"):
    time.sleep(float(os.environ["FAKE_JUDGE_SLEEP"]))
a = answers.get(key, {"refused": "no such fake"})
print(json.dumps(a))
sys.exit(1 if isinstance(a, dict) and "refused" in a else 0)
